    "jackmoebius.info.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMoebius ist eine CoreAudio↔JACK-Audiobrücke. Einmal installiert und aktiviert, erscheint jede macOS-App als JACK-Client, den Sie im Patchbay verbinden können. Ist diese Option aktiv, startet JackMoebius automatisch direkt nach JACK. Ihre JACK-Konfiguration wird nicht verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMoebius is a CoreAudio↔JACK audio bridge. Once installed and enabled, each macOS application appears as a JACK client you can route in the patchbay. When this option is on, JackMoebius starts automatically right after JACK. It does not change your JACK configuration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMoebius es un puente de audio CoreAudio↔JACK. Una vez instalado y activado, cada aplicación de macOS aparece como un cliente JACK que puedes enrutar en el patchbay. Cuando esta opción está activada, JackMoebius se inicia automáticamente justo después de JACK. No modifica tu configuración de JACK."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMoebius est un pont audio CoreAudio↔JACK. Une fois installé et activé, chaque application macOS apparaît comme un client JACK que vous pouvez router dans le patchbay. Quand cette option est cochée, JackMoebius démarre automatiquement juste après JACK. Elle ne modifie pas votre configuration JACK."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMoebius è un ponte audio CoreAudio↔JACK. Una volta installato e attivato, ogni applicazione macOS appare come un client JACK instradabile nel patchbay. Quando questa opzione è attiva, JackMoebius si avvia automaticamente subito dopo JACK. Non modifica la configurazione di JACK."
          }
        }
      }
    },
