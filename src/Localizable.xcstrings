        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no audio context yet: start playback in it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no tiene contexto de audio: inicie una reproducción en ella y vuelva a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas encore de contexte audio : lancez-y une lecture, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha ancora un contesto audio: avvia una riproduzione e riprova."
          }
        }
      }
    },
    "jackmoebius.error.no_card" : {
