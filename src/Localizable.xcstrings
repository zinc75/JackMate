          }
        }
      }
    },
    "jackmoebius.fx.created" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte „JackMoebius for %1$@“ wird erstellt. Starten Sie die App neu oder aktualisieren Sie ihre Geräteliste, falls sie nicht erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The “JackMoebius for %1$@” card is created. Relaunch the app or refresh its device list if it doesn't show up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se crea la tarjeta «JackMoebius for %1$@». Reinicie la app o actualice su lista de dispositivos si no aparece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte « JackMoebius for %1$@ » est créée. Relancez l'app ou rafraîchissez sa liste de périphériques si elle n'apparaît pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda «JackMoebius for %1$@» viene creata. Riavvia l'app o aggiorna la sua lista di dispositivi se non compare."
          }
        }
      }
    },
    "jackmoebius.fx.deleted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte „JackMoebius for %1$@“ wird gelöscht. Hatte %1$@ sie gewählt, wechselt die App auf ein anderes Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
