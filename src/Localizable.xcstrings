    "jackmoebius.panel.help.in_dedicated" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt die Karte „JackMoebius for %1$@“, nur für %1$@: in dessen Einstellungen auszuwählen. Kann %1$@ seinen Eingang nicht wählen, nutzen Sie den JackMoebius-Standard-Stereoeingang (von allen Apps geteilt, die ihn nutzen). Hat %1$@ nur eine Geräteeinstellung für Ein- und Ausgang, stellen Sie auch den Ausgang auf „Dediziert“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates the “JackMoebius for %1$@” card, specific to %1$@: to be selected in its settings. If %1$@ can't choose its input, use the JackMoebius default stereo input (shared by all apps that use it). If %1$@ has a single device setting for input and output, set the output to Dedicated too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea la tarjeta «JackMoebius for %1$@», propia de %1$@: se elige en sus ajustes. Si %1$@ no permite elegir su entrada, usa la entrada estéreo por defecto de JackMoebius (compartida por todas las apps que la usan). Si %1$@ solo tiene un ajuste de dispositivo para entrada y salida, pon también la salida en Dedicado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée la carte « JackMoebius for %1$@ », propre à %1$@ : à choisir dans ses réglages. Si %1$@ ne permet pas de choisir son entrée, utilisez l'entrée stéréo par défaut JackMoebius (partagée entre toutes les apps qui l'utilisent). Si %1$@ n'a qu'un seul réglage de périphérique pour l'entrée et la sortie, mettez aussi la sortie en Dédié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea la scheda «JackMoebius for %1$@», propria di %1$@: da scegliere nelle sue impostazioni. Se %1$@ non permette di scegliere l'ingresso, usa l'ingresso stereo predefinito di JackMoebius (condiviso da tutte le app che lo usano). Se %1$@ ha una sola impostazione di dispositivo per ingresso e uscita, imposta anche l'uscita su Dedicato."
          }
        }
      }
    },
    "jackmoebius.panel.help.in_shared" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ folgt dem Standardeingang des Mac, den JackMoebius übernimmt, solange eine App in diesem Modus ist. Alle Apps in diesem Modus hören denselben Stereo-Stream."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ follows the Mac's default input, which JackMoebius takes over while any app is in this mode. All apps in this mode hear the same stereo stream."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sigue la entrada por defecto del Mac, que JackMoebius toma mientras alguna app esté en este modo. Todas las apps en este modo oyen el mismo flujo estéreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ suit l'entrée par défaut du Mac, que JackMoebius prend tant qu'une app est dans ce mode. Toutes les apps de ce mode entendent le même flux stéréo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ segue l'ingresso predefinito del Mac, che JackMoebius assume finché un'app è in questa modalità. Tutte le app in questa modalità sentono lo stesso flusso stereo."
          }
        }
      }
    },
    "jackmoebius.panel.help.out_dedicated" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt die Karte „JackMoebius for %1$@“: in dessen Einstellungen als Ausgang zu wählen. Kann %1$@ seinen Ausgang nicht wählen, nutzen Sie den JackMoebius-Standardausgang (Stereo, nur für %1$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates the “JackMoebius for %1$@” card: to be selected as the output in its settings. If %1$@ can't choose its output, use the JackMoebius default output (stereo, specific to %1$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea la tarjeta «JackMoebius for %1$@»: se elige como salida en sus ajustes. Si %1$@ no permite elegir su salida, usa la salida por defecto de JackMoebius (estéreo, propia de %1$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée la carte « JackMoebius for %1$@ » : à choisir comme sortie dans ses réglages. Si %1$@ ne permet pas de choisir sa sortie, utilisez la sortie par défaut JackMoebius (stéréo, propre à %1$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea la scheda «JackMoebius for %1$@»: da scegliere come uscita nelle sue impostazioni. Se %1$@ non permette di scegliere l'uscita, usa l'uscita predefinita di JackMoebius (stereo, propria di %1$@)."
          }
        }
      }
    },
    "jackmoebius.panel.help.out_shared" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ spielt auf dem Standardausgang des Mac (JackMoebius), in Stereo, getrennt von anderen Apps. In der App ist nichts einzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ plays to the Mac's default output (JackMoebius), in stereo, kept separate from other apps. Nothing to set in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ suena por la salida por defecto del Mac (JackMoebius), en estéreo, separada de las demás apps. No hay nada que ajustar en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ joue sur la sortie par défaut du Mac (JackMoebius), en stéréo, séparée des autres apps. Rien à régler dans l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ suona sull'uscita predefinita del Mac (JackMoebius), in stereo, separata dalle altre app. Niente da impostare nell'app."
          }
        }
      }
    },
