    "jackmoebius.rebuild.confirm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigeben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free them"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera"
          }
        }
      }
    },
    "jackmoebius.rebuild.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sieht sein Gerät kurz verschwinden und wiederkehren. Die %2$lld ungenutzten Kanäle freigeben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will see its device disappear for a moment, then come back. Free the %2$lld unused channels?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verá su dispositivo desaparecer un instante y volver. ¿Liberar los %2$lld canales sin usar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verra son périphérique disparaître un instant, puis revenir. Libérer les %2$lld canaux inutilisés ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vedrà il suo dispositivo sparire per un istante e poi tornare. Liberare i %2$lld canali inutilizzati?"
          }
        }
      }
    },
    "jackmoebius.rebuild.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungenutzte Kanäle freigeben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free the unused channels?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Liberar los canales sin usar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérer les canaux inutilisés ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberare i canali inutilizzati?"
          }
        }
      }
    },
    "jackmoebius.remove_shared.confirm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trotzdem entfernen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove anyway"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar de todos modos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer quand même"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi comunque"
          }
        }
      }
    },
    "jackmoebius.remove_shared.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie den Eingang von %1$@ entfernen, hört die App den Standardeingang des Mac weiterhin, den JackMoebius behält, solange andere Apps ihn nutzen (%2$@). Damit sie diesen Stream nicht mehr hört, wählen Sie in %1$@ ein anderes Eingangsgerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing the input of %1$@ does not stop it hearing the Mac's default input, which JackMoebius keeps as long as other apps use it (%2$@). To stop it hearing this stream, choose another input device in %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar la entrada de %1$@ no impide que oiga la entrada por defecto del Mac, que JackMoebius conserva mientras otras apps la usen (%2$@). Para que deje de oír este flujo, elija otro dispositivo de entrada en %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer l'entrée de %1$@ ne l'empêche pas d'entendre l'entrée par défaut du Mac, que JackMoebius garde tant que d'autres apps l'utilisent (%2$@). Pour qu'elle n'entende plus ce flux, choisissez un autre périphérique d'entrée dans %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere l'ingresso di %1$@ non gli impedisce di sentire l'ingresso predefinito del Mac, che JackMoebius mantiene finché altre app lo usano (%2$@). Perché non senta più questo flusso, scegli un altro dispositivo di ingresso in %1$@."
          }
        }
      }
    },
    "jackmoebius.remove_shared.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilten Eingang entfernen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
