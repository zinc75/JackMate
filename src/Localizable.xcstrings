          }
        }
      }
    },
    "jackmoebius.rewire.confirm" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwenden und verbinden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply and reconnect"
          }
        },
        "es" : {
