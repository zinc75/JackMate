    "donation.prompt.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMate wird in meiner Freizeit entwickelt und kostenlos als Open Source verteilt.\n\nWenn dir dieses Projekt nützlich ist, würde eine symbolische Spende (freier Betrag) auf Buy Me a Coffee mich für zukünftige Entwicklungen ermutigen und dazu beitragen, die Kosten für das Apple-Entwicklerkonto (99 $/Jahr) zu decken, das JackMate signiert und von Apple notarisiert hält — eine reibungslose Installation ohne Warnungen für alle.\n\nKeine Pflicht — ohne Unterstützung bleibt JackMate vollständig funktionsfähig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMate is developed on my personal time and distributed free of charge as open source.\n\nIf this project is useful to you, a symbolic donation (any amount) on Buy Me a Coffee would encourage me for future developments, and would help cover the recurring Apple Developer account ($99/year) that keeps JackMate signed and notarized by Apple — a smooth, warning-free install for everyone.\n\nNo obligation — without support, JackMate remains fully functional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMate se desarrolla en mi tiempo personal y se distribuye gratuitamente como código abierto.\n\nSi este proyecto te resulta útil, una donación simbólica (importe libre) en Buy Me a Coffee me animaría para los desarrollos futuros, y contribuiría a cubrir el coste de la cuenta de desarrollador de Apple (99 $/año) que mantiene JackMate firmado y notarizado por Apple — una instalación fluida y sin avisos para todos.\n\nSin obligación — sin apoyo, JackMate sigue siendo completamente funcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMate est développé sur mon temps personnel et distribué gratuitement en open source.\n\nSi ce projet vous est utile, une donation symbolique (montant libre) sur Buy Me a Coffee m'encouragerait pour les développements à venir, et contribuerait à couvrir le coût du compte développeur Apple (99 $/an) qui maintient JackMate signé et notarisé par Apple — une installation fluide et sans avertissement pour tous.\n\nPas d'obligation — sans soutien, JackMate reste entièrement fonctionnel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JackMate è sviluppato nel mio tempo libero e distribuito gratuitamente come open source.\n\nSe questo progetto ti è utile, una donazione simbolica (importo libero) su Buy Me a Coffee mi incoraggerebbe per i futuri sviluppi, e contribuirebbe a coprire il costo dell'account sviluppatore Apple (99 $/anno) che mantiene JackMate firmato e notarizzato da Apple — un'installazione fluida e senza avvisi per tutti.\n\nNessun obbligo — senza supporto, JackMate rimane completamente funzionale."
          }
        }
      }
    },
