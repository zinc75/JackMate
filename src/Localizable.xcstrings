    "jackmoebius.error.jack_port_limit" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JACK hat die Registrierung weiterer Ports abgelehnt (JackMoebius hat %lld). Starten Sie JACK mit mehr Ports neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JACK refused to register more ports (JackMoebius has %lld). Restart JACK with a higher number of ports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JACK rechazó registrar más puertos (JackMoebius tiene %lld). Reinicie JACK con más puertos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JACK a refusé d'enregistrer de nouveaux ports (JackMoebius en a %lld). Relancez JACK avec un nombre de ports plus élevé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JACK ha rifiutato di registrare altre porte (JackMoebius ne ha %lld). Riavvia JACK con più porte."
          }
        }
      }
    },
    "jackmoebius.error.no_audio_context" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keinen Audiokontext: Starten Sie dort eine Wiedergabe und versuchen Sie es erneut."
