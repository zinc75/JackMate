    "jackmoebius.mismatch.row.dedicated.in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verwendet seine Eingangskarte nicht. Wählen Sie „JackMoebius for %1$@“ in den Einstellungen von %1$@ als Eingang. Finden Sie diese Einstellung nicht, stellen Sie den Eingang auf „JackMoebius-Standard“ (Schaltfläche oben)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ isn't using its input card. Select “JackMoebius for %1$@” as the input in the settings of %1$@. If you can't find that setting, switch the input to “JackMoebius default” (pill above)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no usa su tarjeta de entrada. Seleccione «JackMoebius for %1$@» como entrada en los ajustes de %1$@. Si no encuentra ese ajuste, ponga la entrada en «JackMoebius por defecto» (botón de arriba)."
          }
