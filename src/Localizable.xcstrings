    "license.error.limit_reached" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben Ihr Aktivierungslimit erreicht. Um einen Mac freizugeben, wenden Sie sich an den Support — oder kaufen Sie eine weitere Lizenz für diesen Mac, wenn Sie keinen Platz auf Ihren anderen Macs freigeben möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've reached your activation limit. To free up a Mac, contact support — or buy another license for this Mac if you'd rather not free a seat on your other Macs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado tu límite de activación. Para liberar un Mac, contacta con soporte — o compra otra licencia para este Mac si prefieres no liberar una plaza en tus otros Macs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez atteint votre limite d'activation. Pour libérer un Mac, contactez le support — ou achetez une autre licence pour ce Mac si vous préférez ne pas libérer de siège sur vos autres Macs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto il limite di attivazioni. Per liberare un Mac, contatta il supporto — oppure acquista un'altra licenza per questo Mac se preferisci non liberare un posto sugli altri Mac."
          }
        }
      }
    },
