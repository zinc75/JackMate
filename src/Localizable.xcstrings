    "jackmoebius.error.capacity_forward_full" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug freie Kanäle auf dem Ausgangsbus: %1$lld nötig, %2$lld übrig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough free channels on the outputs bus: %1$lld needed, %2$lld left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay canales libres suficientes en el bus de salidas: se necesitan %1$lld, quedan %2$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de canaux libres sur le bus des sorties : il en faut %1$lld, il en reste %2$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canali liberi insufficienti sul bus delle uscite: ne servono %1$lld, ne restano %2$lld."
          }
        }
      }
    },
    "jackmoebius.error.capacity_fragmented" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ausgangsbus ist fragmentiert: %lld Kanäle sind frei, aber kein Paar benachbarter Kanäle für einen Stereo-Ausgang. Geben Sie Karten unter Reservierungen frei oder bauen Sie sie neu auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The outputs bus is fragmented: %lld channels are free, but no pair of neighbouring channels for a stereo output. Free or rebuild cards in Reservations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bus de salidas está fragmentado: quedan %lld canales libres, pero ningún par de canales vecinos para una salida estéreo. Libere o reconstruya tarjetas en Reservas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bus des sorties est fragmenté : il reste %lld canaux libres, mais aucune paire de canaux voisins pour une sortie stéréo. Libérez ou reconstruisez des cartes dans Réservations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bus delle uscite è frammentato: restano %lld canali liberi, ma nessuna coppia di canali vicini per un'uscita stereo. Libera o ricostruisci schede in Prenotazioni."
          }
        }
      }
    },
    "jackmoebius.error.capacity_held" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von den belegten Kanälen sind %lld reserviert, aber ungenutzt (eine Karte, deren Ein- oder Ausgang entfernt wurde): Sie können sie unter Reservierungen freigeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of the occupied channels, %lld are reserved but unused (a card whose input or output was removed): you can free them in Reservations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De los canales ocupados, %lld están reservados sin usar (una tarjeta a la que se quitó una entrada o salida): puede liberarlos en Reservas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmi les canaux occupés, %lld sont réservés sans être utilisés (une carte dont une entrée ou une sortie a été retirée) : vous pouvez les libérer dans Réservations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dei canali occupati, %lld sono riservati ma inutilizzati (una scheda a cui è stato tolto un ingresso o un'uscita): puoi liberarli in Prenotazioni."
          }
        }
      }
    },
