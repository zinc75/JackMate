    "jackmoebius.mismatch.banner.hint" : {
      "comment" : "Routing mismatch banner: how the alert clears",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Meldung verschwindet, sobald die richtige Quelle gewählt ist (in der App oder in den Systemeinstellungen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This message clears once the right source is selected (in the app or in System Settings)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje desaparece cuando se selecciona la fuente correcta (en la app o en Ajustes del Sistema)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
