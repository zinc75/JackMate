    "jackmoebius.reason.other_account_running.remedy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Konto kann JackMoebius gleichzeitig nutzen: Bitten Sie es, JACK zu beenden oder sich abzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one account can use JackMoebius at a time: ask them to quit JACK, or to log out of their session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo una cuenta puede usar JackMoebius a la vez: pídale que cierre JACK o su sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul compte peut utiliser JackMoebius à la fois : demandez-lui de quitter JACK ou de fermer sa session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo account alla volta può usare JackMoebius: chiedi di chiudere JACK o di uscire dalla sessione."
          }
        }
      }
    },
    "jackmoebius.reason.other_account_stale_socket" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Konto („%@“) hat den JackMoebius-Socket zurückgelassen (/tmp/jackmoebius.sock)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another account (“%@”) left the JackMoebius socket behind (/tmp/jackmoebius.sock)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra cuenta («%@») dejó el socket de JackMoebius (/tmp/jackmoebius.sock)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre compte (« %@ ») a laissé le socket JackMoebius derrière lui (/tmp/jackmoebius.sock)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro account («%@») ha lasciato il socket di JackMoebius (/tmp/jackmoebius.sock)."
          }
        }
      }
    },
    "jackmoebius.reason.other_account_stale_socket.remedy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto muss die Datei löschen, oder ein Administrator: sudo rm /tmp/jackmoebius.sock (ein Neustart löscht sie ebenfalls)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That account has to delete the file, or an administrator can: sudo rm /tmp/jackmoebius.sock (a restart also clears it)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa cuenta debe borrar el archivo, o un administrador: sudo rm /tmp/jackmoebius.sock (un reinicio también lo elimina)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte doit supprimer le fichier, ou un administrateur : sudo rm /tmp/jackmoebius.sock (un redémarrage l'efface aussi)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell'account deve eliminare il file, oppure un amministratore: sudo rm /tmp/jackmoebius.sock (anche un riavvio lo cancella)."
          }
        }
      }
    },
    "jackmoebius.reason.title" : {
      "localizations" : {
        "de" : {
