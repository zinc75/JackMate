    "jackmoebius.blacklist.confirm.message" : {
      "comment" : "Blacklist confirmation message; %@ = app name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist im JACK-Graphen sichtbar. Zum Blacklisten muss sie zuerst aus dem Graphen entfernt werden (Aus- und Eingänge)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is exposed in the JACK graph. To blacklist it, it must be removed from the graph first (outputs + inputs)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está expuesta en el grafo JACK. Para añadirla a la lista negra, primero hay que quitarla del grafo (salidas y entradas)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est exposée dans le graphe JACK. Pour la blacklister, elle doit d'abord en être retirée (sorties + entrées)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è esposta nel grafo JACK. Per inserirla nella blacklist va prima rimossa dal grafo (uscite e ingressi)."
          }
        }
      }
    },
