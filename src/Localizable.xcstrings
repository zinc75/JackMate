          }
        }
      }
    },
    "jackmoebius.fx.recreated_add.in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte „JackMoebius for %1$@“ wird mit dem zusätzlichen Eingang neu erstellt: %1$@ sieht sein Gerät kurz verschwinden und wiederkehren."
