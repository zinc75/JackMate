    "jackmoebius.mismatch.banner.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Lösungen:\n• In der App: Wählen Sie in ihren Einstellungen das oben genannte JackMoebius-Gerät.\n• In JackMate, wenn die App keine Auswahl eines Audio-Ein- oder -Ausgabegeräts erlaubt: Klicken Sie in der App-Liste dieses Bereichs auf ihre Schaltfläche und stellen Sie ihren Eingang oder Ausgang auf „JackMoebius-Standard“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two solutions:\n• In the app: select the JackMoebius device indicated above in its settings.\n• In JackMate, if the app doesn't let you choose an audio input or output device: click its pill in the app list of this panel and switch its input or output to “JackMoebius default”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos soluciones:\n• En la app: seleccione en sus ajustes el dispositivo JackMoebius indicado arriba.\n• En JackMate, si la app no permite elegir un dispositivo de audio de entrada o salida: haga clic en su botón en la lista de apps de este panel y ponga su entrada o salida en «JackMoebius por defecto»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux solutions :\n• Dans l'application : sélectionnez dans ses réglages le périphérique JackMoebius indiqué ci-dessus.\n• Dans JackMate, si l'application ne permet pas de choisir de périphérique audio en entrée ou en sortie : cliquez sur sa pastille dans la liste des applications de ce panneau et passez son entrée ou sa sortie en « Défaut JackMoebius »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due soluzioni:\n• Nell'app: seleziona nelle sue impostazioni il dispositivo JackMoebius indicato sopra.\n• In JackMate, se l'app non permette di scegliere un dispositivo audio di ingresso o di uscita: clicca sul suo pulsante nell'elenco delle app di questo pannello e imposta il suo ingresso o la sua uscita su «Predefinito JackMoebius»."
          }
        }
      }
    },
    "jackmoebius.mismatch.banner.title" : {
      "comment" : "Routing mismatch banner: title",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
