    "jackmoebius.cleanup.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wechselt zu einer dedizierten Karte. Diese Kabel wurden für die App am geteilten Eingang gezogen:\n%2$@\nSie werden nicht mehr gebraucht. Vom geteilten Eingang entfernen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is moving to a dedicated card. These cables were drawn for it on the shared input:\n%2$@\nThey are of no use to it any more. Remove them from the shared input?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pasa a una tarjeta dedicada. Estos cables se habían tendido para ella en la entrada compartida:\n%2$@\nYa no le sirven. ¿Quitarlos de la entrada compartida?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ passe en carte dédiée. Ces câbles avaient été tirés pour lui sur l'entrée partagée :\n%2$@\nIls ne lui servent plus. Les retirer de l'entrée partagée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ passa a una scheda dedicata. Questi cavi erano stati tracciati per essa sull'ingresso condiviso:\n%2$@\nNon le servono più. Rimuoverli dall'ingresso condiviso?"
          }
        }
      }
    },
