    "jackmoebius.capacity.held.help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kanäle bleiben von einer Karte reserviert, deren Ein- oder Ausgang entfernt wurde. Sie werden freigegeben, wenn die Karte gelöscht oder neu aufgebaut wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These channels stay reserved by a card whose input or output was removed. They are released when the card is deleted or rebuilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos canales siguen reservados por una tarjeta a la que se quitó una entrada o salida. Se liberan cuando la tarjeta se elimina o se reconstruye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces canaux restent réservés par une carte dont une entrée ou une sortie a été retirée. Ils sont libérés quand la carte est supprimée ou reconstruite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi canali restano riservati da una scheda a cui è stato tolto un ingresso o un'uscita. Vengono liberati quando la scheda viene eliminata o ricostruita."
          }
        }
      }
    },
