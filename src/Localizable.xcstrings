    "jackmoebius.advanced.show_system_node.help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig ist dieser Knoten ausgeblendet, solange eine App im geteilten Eingangsmodus angezeigt wird: Seine Kabel werden dann in der Box jeder App gezeichnet. Er erscheint von selbst wieder, wenn noch Kabel daran hängen und keine App den Eingang mehr teilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default this node is hidden while an app in shared input mode is shown: its cables are drawn in each app's box. It reappears on its own when cables remain on it and no app shares the input any more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada, este nodo se oculta mientras se muestre una app en modo de entrada compartida: sus cables se dibujan entonces en la caja de cada app. Reaparece solo cuando quedan cables en él y ninguna app comparte ya la entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, ce nœud est masqué tant qu'une app en entrée partagée est affichée : ses câbles sont alors dessinés dans la boîte de chaque app. Il réapparaît seul quand il reste des câbles dessus et qu'aucune app ne partage plus l'entrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostazione predefinita questo nodo è nascosto finché è mostrata un'app in ingresso condiviso: i suoi cavi sono allora disegnati nel riquadro di ogni app. Riappare da solo quando restano cavi su di esso e nessuna app condivide più l'ingresso."
          }
        }
      }
    },
