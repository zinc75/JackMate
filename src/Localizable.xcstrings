    "jackmoebius.panel.shared_input_in_use" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Apps verwenden den JackMoebius-Standardeingang (%@): Alle hören denselben Stereo-Stream. Das ist bei einer App ohne Audio-Eingangsauswahl normal, sie hat keine andere Möglichkeit; hat die App eine, ist eine dedizierte Karte vorzuziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Several apps use the JackMoebius default input (%@): they all hear the same stereo stream. This is expected for an app without an audio input selector, which has no other option; if the app has one, prefer a dedicated card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varias apps usan la entrada por defecto de JackMoebius (%@): todas oyen el mismo flujo estéreo. Es lo normal en una app sin selector de entrada de audio, que no tiene otra opción; si la app lo tiene, es preferible una tarjeta dedicada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs apps utilisent l'entrée par défaut de JackMoebius (%@) : elles entendent toutes le même flux stéréo. C'est normal pour une app sans sélecteur d'entrée audio, qui n'a pas d'autre option ; si l'app en a un, préférez une carte dédiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più app usano l'ingresso predefinito di JackMoebius (%@): tutte sentono lo stesso flusso stereo. È normale per un'app senza selettore di ingresso audio, che non ha altra opzione; se l'app ne ha uno, è preferibile una scheda dedicata."
          }
        }
      }
    },
