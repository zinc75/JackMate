      }
    },
    "jackmoebius.fx.kept.in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte „JackMoebius for %1$@“ bleibt ohne ihren Eingang bestehen: %1$@ sieht sie weiterhin, der Eingang ist aber nicht mehr angebunden. Wählen Sie in %1$@ das Gerät „JackMoebius“ als Eingang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The “JackMoebius for %1$@” card is kept without its input: %1$@ still sees it, but the input is no longer wired to it. In %1$@, choose the “JackMoebius” device as the input."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta «JackMoebius for %1$@» se conserva sin su entrada: %1$@ aún la ve, pero la entrada ya no está conectada. En %1$@, elija el dispositivo «JackMoebius» como entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte « JackMoebius for %1$@ » est conservée sans son entrée : %1$@ la voit encore, mais l'entrée n'y est plus branchée. Dans %1$@, choisissez le périphérique « JackMoebius » comme entrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda «JackMoebius for %1$@» viene mantenuta senza il suo ingresso: %1$@ la vede ancora, ma l'ingresso non è più collegato. In %1$@, scegli il dispositivo «JackMoebius» come ingresso."
          }
        }
      }
    },
    "jackmoebius.fx.kept.out" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte „JackMoebius for %1$@“ bleibt ohne ihren Ausgang bestehen: %1$@ sieht sie weiterhin, der Ausgang ist aber nicht mehr angebunden. Wählen Sie in %1$@ das Gerät „JackMoebius“ als Ausgang."
