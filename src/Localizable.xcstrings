    "jackmoebius.reservations.in_shared.help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilter Eingang: 2 Kanäle für alle Apps gemeinsam, nicht in der Kapazität gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared input: 2 channels common to all apps, not counted in the capacity."
          }
        },
        "es" : {
          "stringUnit" : {
