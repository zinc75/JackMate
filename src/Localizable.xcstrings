    "jackmoebius.rewire.ignore" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anwenden ohne Verbinden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply without reconnecting"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar sin reconectar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer sans reconnecter"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica senza ricollegare"
          }
        }
      }
    },
    "jackmoebius.rewire.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wechselt zurück zum JackMoebius-Standardeingang, den auch andere Apps hören (%2$@). Durch die Änderung werden die Quellen seiner Karte getrennt. Verbinden Sie sie wieder, hören diese Apps sie ebenfalls."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is going back to the JackMoebius default input, which other apps also hear (%2$@). The change disconnects the sources of its card. If you reconnect them, those apps will hear them too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vuelve a la entrada por defecto de JackMoebius, que otras apps también oyen (%2$@). El cambio desconecta las fuentes de su tarjeta. Si las reconecta, esas apps también las oirán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ repasse sur l'entrée par défaut de JackMoebius, que d'autres apps écoutent aussi (%2$@). Le changement déconnecte les sources de sa carte. Si vous les reconnectez, ces apps les entendront également."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ torna all'ingresso predefinito di JackMoebius, che anche altre app sentono (%2$@). La modifica scollega le sorgenti della sua scheda. Se le ricolleghi, quelle app le sentiranno a loro volta."
          }
        }
      }
    },
    "jackmoebius.rewire.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen des Eingangs wieder verbinden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnect the input's sources?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Reconectar las fuentes de la entrada?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnecter les sources de l'entrée ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricollegare le sorgenti dell'ingresso?"
          }
        }
      }
    },
