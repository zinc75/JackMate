    "jackmoebius.error.own_held" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der dedizierte Eingang von %1$@ behält seine Karte: Wechselt nur der Ausgang auf „JackMoebius-Standard“, blieben seine %2$lld Ausgangskanäle reserviert, aber ungenutzt, und der Ausgangsbus ist zu voll, um sie zu halten. Stellen Sie auch den Eingang auf „JackMoebius-Standard“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dedicated input of %1$@ keeps its card: if only its output moves to “JackMoebius default”, its %2$lld output channels would stay reserved but unused, and the outputs bus is too full to keep them. Move its input to “JackMoebius default” too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada dedicada de %1$@ conserva su tarjeta: si solo su salida pasa a «JackMoebius por defecto», sus %2$lld canales de salida quedarían reservados sin usar, y el bus de salidas está demasiado lleno para conservarlos. Ponga también su entrada en «JackMoebius por defecto»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée dédiée de %1$@ garde sa carte : si seule sa sortie passe en « Défaut JackMoebius », ses %2$lld voies de sortie resteraient réservées sans être utilisées, et le bus des sorties est trop plein pour les garder. Passez aussi son entrée en « Défaut JackMoebius »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ingresso dedicato di %1$@ mantiene la sua scheda: se solo la sua uscita passa a «Predefinito JackMoebius», i suoi %2$lld canali di uscita resterebbero riservati ma inutilizzati, e il bus delle uscite è troppo pieno per tenerli. Imposta anche il suo ingresso su «Predefinito JackMoebius»."
          }
        }
      }
    },
    "jackmoebius.error.slot_exhausted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Platz für eine neue Karte (maximal %lld). Löschen Sie eine ungenutzte Karte in den Reservierungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No room for a new card (maximum %lld). Delete an unused card in the reservations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay sitio para una nueva tarjeta (máximo %lld). Elimine una tarjeta sin usar en las reservas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de place pour une nouvelle carte (maximum %lld). Supprimez une carte inutilisée dans les réservations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno spazio per una nuova scheda (massimo %lld). Elimina una scheda inutilizzata nelle prenotazioni."
          }
        }
      }
    },
    "jackmoebius.error.transport_not_ready" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die JackMoebius-Audiobrücke ist nicht bereit: Eine dedizierte Karte kann derzeit nicht erstellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
