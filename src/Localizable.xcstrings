    "aggregate.warning.body" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ein- und Ausgabegerät sind unterschiedliche physikalische Geräte. Jack kombiniert sie automatisch zu einem Aggregatgerät. Die Kanäle werden in folgender Reihenfolge zugeordnet:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your input and output devices are different physical devices. Jack will silently combine them into an aggregate. Channels will be mapped in this order:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus dispositivos de entrada y salida son dispositivos físicos diferentes. Jack los combinará automáticamente en un agregado. Los canales se asignarán en este orden:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos devices d'entrée et de sortie sont des périphériques physiques différents. Jack va les combiner silencieusement en un agrégat. Les canaux seront mappés dans l'ordre suivant :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dispositivi di ingresso e uscita sono periferiche fisiche diverse. Jack li combinerà automaticamente in un aggregato. I canali verranno mappati in quest'ordine:"
          }
        }
      }
    },
